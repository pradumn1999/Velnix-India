APP_URL="MY_APP_URL"

# Razorpay Payment Gateway (Optional - falls back to high-fidelity test sandbox if empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# CJdropshipping API Gateway (Optional - falls back to high-fidelity test simulator if empty)
