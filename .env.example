
# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Razorpay Payment Gateway (Optional - falls back to high-fidelity test sandbox if empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# CJdropshipping API Gateway (Optional - falls back to high-fidelity test simulator if empty)
CJ_API_EMAIL=
CJ_API_KEY=

# MongoDB Database Connection URI (MongoDB Atlas or standalone MongoDB)
# When set, user registrations, logins, and profiles are persisted in MongoDB 'velnix' database.
# If empty or not set, the app runs with an in-memory test store so the app never crashes.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/velnix?retryWrites=true&w=majority

